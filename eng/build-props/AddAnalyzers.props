<Project>
    <!--
        Analyzer wiring.

        Configuration is split three ways:
          .editorconfig (repository root)            - whitespace, code-style preferences, Rider/ReSharper formatting
          analyzers/severity.*.globalconfig          - rule severities, one file per analyzer family
          analyzers/stylecop.json                    - StyleCop settings that have no editorconfig equivalent

        Global analyzer config precedence is by global_level: the family files sit at 100, the test overlay at 200
        and the benchmark overlay at 300, so an overlay always wins. Two files at the same level must never set the
        same key, which is why the family files are partitioned strictly by rule-ID prefix and only
        severity.dotnet.globalconfig owns the dotnet_analyzer_diagnostic.category-* settings.
    -->
    <PropertyGroup Condition="'$(EnableAnalyzers)' == 'true'">
        <AnalysisLevel>latest</AnalysisLevel>
        <AnalysisMode>AllEnabledByDefault</AnalysisMode>
        <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <LangVersion>latest</LangVersion>
        <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
        <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AnalyzerConfigDirectory>$(RootDirectory)eng/build-props/analyzers</AnalyzerConfigDirectory>
    </PropertyGroup>

    <ItemGroup Condition="'$(EnableAnalyzers)' == 'true'">
        <GlobalAnalyzerConfigFiles Include="$(AnalyzerConfigDirectory)/severity.dotnet.globalconfig"
                                   Link="severity.dotnet.globalconfig"/>
        <GlobalAnalyzerConfigFiles Include="$(AnalyzerConfigDirectory)/severity.roslynator.globalconfig"
                                   Link="severity.roslynator.globalconfig"/>
        <GlobalAnalyzerConfigFiles Include="$(AnalyzerConfigDirectory)/severity.stylecop.globalconfig"
                                   Link="severity.stylecop.globalconfig"/>
        <GlobalAnalyzerConfigFiles Include="$(AnalyzerConfigDirectory)/severity.meziantou.globalconfig"
                                   Link="severity.meziantou.globalconfig"/>

        <GlobalAnalyzerConfigFiles Include="$(AnalyzerConfigDirectory)/severity.tests.globalconfig"
                                   Link="severity.tests.globalconfig"
                                   Condition="'$(TestProject)' == 'true'"/>
        <GlobalAnalyzerConfigFiles Include="$(AnalyzerConfigDirectory)/severity.benchmarks.globalconfig"
                                   Link="severity.benchmarks.globalconfig"
                                   Condition="'$(BenchmarkProject)' == 'true'"/>

        <AdditionalFiles Include="$(AnalyzerConfigDirectory)/stylecop.json"
                         Link="stylecop.json"/>
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.CLSCompliant">
            <_Parameter1>false</_Parameter1>
            <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup Condition="'$(EnableAnalyzers)' == 'true'">
        <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Meziantou.Analyzer">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Roslynator.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Roslynator.Formatting.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="StyleCop.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
</Project>
