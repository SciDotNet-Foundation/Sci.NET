########################################################################################################################
# Meziantou.Analyzer rule severities.
#
# Package: Meziantou.Analyzer 3.0.262.
#
# Meziantou ships ~236 rules, 176 of them enabled by default, and reuses the standard Design/Usage/Performance/
# Style categories. That means a category-level default would collide with the CA and IDE settings in
# severity.dotnet.globalconfig, so every rule is listed explicitly here instead.
#
# The policy is opt-in: MA rules default to "none" and are turned on one at a time. Rules that merely restate
# something Roslynator, StyleCop or the .NET analyzers already enforce stay off, so a violation is reported once
# rather than three times. Rules that would contradict a preference set elsewhere are listed at the bottom with
# the reason.
########################################################################################################################

is_global = true
global_level = 100

#----------------------------------------------------------------------------------------------------------------------
# Struct and value-type correctness
#----------------------------------------------------------------------------------------------------------------------

# MA0065: Default ValueType.Equals or HashCode is used for struct equality
dotnet_diagnostic.MA0065.severity = warning

# MA0066: Hash table unfriendly type is used in a hash table
dotnet_diagnostic.MA0066.severity = warning

# MA0102: Make member readonly
dotnet_diagnostic.MA0102.severity = warning

# MA0168: Use readonly struct for in or ref readonly parameter
dotnet_diagnostic.MA0168.severity = warning

# MA0189: Use InlineArray instead of fixed-size buffers
dotnet_diagnostic.MA0189.severity = warning

# MA0209: Use in keyword for in parameter
dotnet_diagnostic.MA0209.severity = suggestion

# MA0210: Use in keyword to call the in overload
dotnet_diagnostic.MA0210.severity = suggestion

# MA0212: Use MemoryMarshal.GetReference instead of indexing at 0
dotnet_diagnostic.MA0212.severity = suggestion

#----------------------------------------------------------------------------------------------------------------------
# Equality and comparison contracts
#----------------------------------------------------------------------------------------------------------------------

# MA0077: A class that provides Equals(T) should implement IEquatable<T>
dotnet_diagnostic.MA0077.severity = warning

# MA0094: A class that provides CompareTo(T) should implement IComparable<T>
dotnet_diagnostic.MA0094.severity = warning

# MA0095: A class that implements IEquatable<T> should override Equals(object)
dotnet_diagnostic.MA0095.severity = warning

# MA0096: A class that implements IComparable<T> should also implement IEquatable<T>
dotnet_diagnostic.MA0096.severity = warning

# MA0097: A class that implements IComparable<T> or IComparable should override comparison operators
dotnet_diagnostic.MA0097.severity = warning

# MA0103: Use SequenceEqual instead of equality operator
dotnet_diagnostic.MA0103.severity = warning

# MA0186: Equals method should use [NotNullWhen(true)] on the parameter
# 9 outstanding site(s) - promote to warning once they are fixed.
dotnet_diagnostic.MA0186.severity = suggestion

#----------------------------------------------------------------------------------------------------------------------
# Numeric correctness
#----------------------------------------------------------------------------------------------------------------------

# MA0082: NaN should not be used in comparisons
dotnet_diagnostic.MA0082.severity = warning

# MA0193: Use an overload with a MidpointRounding argument
dotnet_diagnostic.MA0193.severity = warning

#----------------------------------------------------------------------------------------------------------------------
# Allocation and closures
#----------------------------------------------------------------------------------------------------------------------

# MA0105: Use the lambda parameters instead of using a closure
dotnet_diagnostic.MA0105.severity = warning

# MA0106: Avoid closure by using an overload with the 'factoryArgument' parameter
dotnet_diagnostic.MA0106.severity = warning

# MA0217: Use a static lambda
# 66 outstanding site(s) - promote to warning once they are fixed.
dotnet_diagnostic.MA0217.severity = suggestion

#----------------------------------------------------------------------------------------------------------------------
# LINQ and collections
#----------------------------------------------------------------------------------------------------------------------

# MA0020: Use direct methods instead of LINQ methods
dotnet_diagnostic.MA0020.severity = warning

# MA0029: Combine LINQ methods
dotnet_diagnostic.MA0029.severity = warning

# MA0030: Remove useless OrderBy call
dotnet_diagnostic.MA0030.severity = warning

# MA0031: Optimize Enumerable.Count() usage
# 6 outstanding site(s) - promote to warning once they are fixed.
dotnet_diagnostic.MA0031.severity = suggestion

# MA0063: Use Where before OrderBy
dotnet_diagnostic.MA0063.severity = warning

# MA0098: Use indexer instead of LINQ methods
dotnet_diagnostic.MA0098.severity = warning

# MA0159: Use 'Order' instead of 'OrderBy'
dotnet_diagnostic.MA0159.severity = warning

# MA0160: Use ContainsKey instead of TryGetValue
dotnet_diagnostic.MA0160.severity = warning

# MA0227: Avoid using 'Enumerable.Contains' on a set
dotnet_diagnostic.MA0227.severity = warning

#----------------------------------------------------------------------------------------------------------------------
# Exceptions
#----------------------------------------------------------------------------------------------------------------------

# MA0012: Do not raise reserved exception type
dotnet_diagnostic.MA0012.severity = warning

# MA0013: Types should not extend System.ApplicationException
dotnet_diagnostic.MA0013.severity = warning

# MA0014: Do not raise System.ApplicationException type
dotnet_diagnostic.MA0014.severity = warning

# MA0015: Specify the parameter name in ArgumentException
# 14 outstanding site(s) - promote to warning once they are fixed.
dotnet_diagnostic.MA0015.severity = suggestion

# MA0043: Use nameof operator in ArgumentException
dotnet_diagnostic.MA0043.severity = warning

# MA0054: Embed the caught exception as innerException
dotnet_diagnostic.MA0054.severity = warning

# MA0072: Do not throw from a finally block
dotnet_diagnostic.MA0072.severity = warning

# MA0086: Do not throw from a finalizer
dotnet_diagnostic.MA0086.severity = warning

# MA0131: ArgumentNullException.ThrowIfNull should not be used with non-nullable types
dotnet_diagnostic.MA0131.severity = warning

#----------------------------------------------------------------------------------------------------------------------
# Enums
#----------------------------------------------------------------------------------------------------------------------

# MA0052: Replace constant Enum.ToString with nameof
dotnet_diagnostic.MA0052.severity = warning

# MA0062: Non-flags enums should not be marked with "FlagsAttribute"
dotnet_diagnostic.MA0062.severity = warning

# MA0201: Do not use zero-valued enum flags in flag checks
dotnet_diagnostic.MA0201.severity = warning

#----------------------------------------------------------------------------------------------------------------------
# Async and threading
#----------------------------------------------------------------------------------------------------------------------

# MA0033: Do not tag instance fields with ThreadStaticAttribute
dotnet_diagnostic.MA0033.severity = warning

# MA0035: Do not use dangerous threading methods
dotnet_diagnostic.MA0035.severity = warning

# MA0042: Do not use blocking calls when the calling method is async
dotnet_diagnostic.MA0042.severity = warning

# MA0045: Do not use blocking calls, even when the calling method must become async
# 1 outstanding site(s) - promote to warning once they are fixed.
dotnet_diagnostic.MA0045.severity = suggestion

# MA0100: Await task before disposing of resources
dotnet_diagnostic.MA0100.severity = warning

# MA0129: Await task in using statement
dotnet_diagnostic.MA0129.severity = warning

# MA0134: Observe result of async calls
dotnet_diagnostic.MA0134.severity = warning

# MA0147: Avoid async void method for delegate
dotnet_diagnostic.MA0147.severity = warning

# MA0152: Use Unwrap instead of using await twice
dotnet_diagnostic.MA0152.severity = warning

# MA0155: Do not use async void methods
dotnet_diagnostic.MA0155.severity = warning

# MA0158: Use System.Threading.Lock
dotnet_diagnostic.MA0158.severity = warning

#----------------------------------------------------------------------------------------------------------------------
# Patterns and readability
#----------------------------------------------------------------------------------------------------------------------

# MA0141: Use 'is not null' instead of '!= null'
dotnet_diagnostic.MA0141.severity = warning

# MA0142: Use 'is null' instead of '== null'
dotnet_diagnostic.MA0142.severity = warning

# MA0164: Use parentheses to make not pattern clearer
dotnet_diagnostic.MA0164.severity = warning

# MA0171: Use 'is null' / 'is not null' instead of Nullable<T>.HasValue
dotnet_diagnostic.MA0171.severity = warning

# MA0194: Merge is expressions on the same value
dotnet_diagnostic.MA0194.severity = warning

# MA0205: Use exclusive or operator
dotnet_diagnostic.MA0205.severity = warning

# MA0213: Simplify negated boolean expression
dotnet_diagnostic.MA0213.severity = warning

#----------------------------------------------------------------------------------------------------------------------
# Duplicated and dead code
#----------------------------------------------------------------------------------------------------------------------

# MA0140: Both if and else branch have identical code
dotnet_diagnostic.MA0140.severity = warning

# MA0172: Both sides of the logical operation are identical
# 1 outstanding site(s) - promote to warning once they are fixed.
dotnet_diagnostic.MA0172.severity = suggestion

# MA0182: Avoid unused internal types
dotnet_diagnostic.MA0182.severity = warning

# MA0195: Do not use static fields before they are initialized
dotnet_diagnostic.MA0195.severity = warning

# MA0202: Conditional compilation branches have identical code
dotnet_diagnostic.MA0202.severity = warning

