# MA0170: Type cannot be used as an attribute argument
dotnet_diagnostic.MA0170.severity = warning

# MA0176: Optimize guid creation
dotnet_diagnostic.MA0176.severity = warning

# MA0178: Use TimeSpan.Zero instead of TimeSpan.FromXXX(0)
dotnet_diagnostic.MA0178.severity = warning

# MA0179: Use Attribute.IsDefined instead of GetCustomAttribute(s)
dotnet_diagnostic.MA0179.severity = warning

# MA0183: The format string should use placeholders
dotnet_diagnostic.MA0183.severity = warning

# MA0185: Simplify string.Create when all parameters are culture invariant
dotnet_diagnostic.MA0185.severity = warning

# MA0239: Use 'typeof' instead of 'GetType()' when the type is sealed
# 1 outstanding site(s) - promote to warning once they are fixed.
dotnet_diagnostic.MA0239.severity = suggestion

#----------------------------------------------------------------------------------------------------------------------
# Events and members
#----------------------------------------------------------------------------------------------------------------------

# MA0061: Method overrides should not change default values
# 4 outstanding site(s) - promote to warning once they are fixed.
dotnet_diagnostic.MA0061.severity = suggestion

# MA0083: ConstructorArgument parameters should exist in constructors
dotnet_diagnostic.MA0083.severity = warning

# MA0084: Local variables should not hide other symbols
dotnet_diagnostic.MA0084.severity = warning

# MA0085: Anonymous delegates should not be used to unsubscribe from Events
dotnet_diagnostic.MA0085.severity = warning

# MA0087: Parameters with [DefaultParameterValue] attributes should also be marked [Optional]
dotnet_diagnostic.MA0087.severity = warning

# MA0088: Use [DefaultParameterValue] instead of [DefaultValue]
dotnet_diagnostic.MA0088.severity = warning

# MA0091: Sender should be 'this' for instance events
dotnet_diagnostic.MA0091.severity = warning

# MA0092: Sender should be 'null' for static events
dotnet_diagnostic.MA0092.severity = warning

# MA0093: EventArgs should not be null when raising an event
dotnet_diagnostic.MA0093.severity = warning

