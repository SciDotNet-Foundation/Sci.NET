# Documentation
#----------------------------------------------------------------------------------------------------------------------

# MA0154: Use langword in XML comment
# 37 outstanding site(s) - promote to warning once they are fixed.
dotnet_diagnostic.MA0154.severity = suggestion

# MA0196: Do not use inheritdoc on non-inheriting members
dotnet_diagnostic.MA0196.severity = warning

# MA0199: Do not use inheritdoc on types without inheritance source
dotnet_diagnostic.MA0199.severity = warning

# MA0203: Do not use return tag for void method
dotnet_diagnostic.MA0203.severity = warning

# MA0211: Use multi-line syntax for XML summary comments
dotnet_diagnostic.MA0211.severity = warning

#----------------------------------------------------------------------------------------------------------------------
# Off: already covered elsewhere, or contradicts a preference set in this repository
#----------------------------------------------------------------------------------------------------------------------

# MA0004: Use Task.ConfigureAwait
#   -> CA2007 and RCS1090 are both off - no ConfigureAwait policy in a compute library
dotnet_diagnostic.MA0004.severity = none

# MA0005: Use Array.Empty<T>()
#   -> IDE0301 prefers a collection expression [] over Array.Empty<T>()
dotnet_diagnostic.MA0005.severity = none

# MA0007: Add a comma after the last value
#   -> SA1413 (trailing comma in multi-line initializers) is off
dotnet_diagnostic.MA0007.severity = none

# MA0011: IFormatProvider is missing
#   -> CA1305 already requires IFormatProvider
dotnet_diagnostic.MA0011.severity = none

# MA0025: Implement the functionality instead of throwing NotImplementedException
#   -> RCS1079 already flags NotImplementedException
dotnet_diagnostic.MA0025.severity = none

# MA0036: Make class static
#   -> RCS1102 already requires static classes
dotnet_diagnostic.MA0036.severity = none

# MA0044: Remove useless ToString call
#   -> RCS1097 already removes redundant ToString calls
dotnet_diagnostic.MA0044.severity = none

# MA0047: Declare types in namespaces
#   -> RCS1110 already requires types inside a namespace
dotnet_diagnostic.MA0047.severity = none

# MA0048: File name must match type name
#   -> SA1649 already matches file name to type name
dotnet_diagnostic.MA0048.severity = none

# MA0053: Make class or record sealed
#   -> RCS1225 already requires sealed classes
dotnet_diagnostic.MA0053.severity = none

# MA0064: Avoid locking on publicly accessible instance
#   -> RCS1059 already forbids locking on a public instance
dotnet_diagnostic.MA0064.severity = none

# MA0071: Avoid using redundant else
#   -> RCS1211 already removes redundant else
dotnet_diagnostic.MA0071.severity = none

# MA0073: Avoid comparison with bool constant
#   -> RCS1033 and RCS1049 already cover bool constant comparisons
dotnet_diagnostic.MA0073.severity = none

# MA0081: Method overrides should not omit params keyword
#   -> RCS1193 already covers params on overrides
dotnet_diagnostic.MA0081.severity = none

# MA0104: Do not create a type with a name from the BCL
#   -> Matrix, Vector and Tensor deliberately mirror BCL names
dotnet_diagnostic.MA0104.severity = none

# MA0109: Consider adding an overload with a Span<T> or Memory<T>
#   -> adding a Span<T> overload everywhere is not actionable advice here
dotnet_diagnostic.MA0109.severity = none

# MA0112: Use 'Count > 0' instead of 'Any()'
#   -> RCS1080 (Count/Length over Any) is deliberately off
dotnet_diagnostic.MA0112.severity = none

# MA0137: Use 'Async' suffix when a method returns an awaitable type
#   -> RCS1046 and VSTHRD200 already own the Async suffix policy
dotnet_diagnostic.MA0137.severity = none

# MA0138: Do not use 'Async' suffix when a method does not return an awaitable type
#   -> RCS1047 already owns the non-async suffix policy
dotnet_diagnostic.MA0138.severity = none

# MA0148: Use 'is' patterns instead of '==' for constant values
#   -> would fire on every numeric "== 0" comparison in kernel code
dotnet_diagnostic.MA0148.severity = none

# MA0149: Use 'is not' patterns instead of '!=' for constant values
#   -> same as MA0148
dotnet_diagnostic.MA0149.severity = none

# MA0177: Use single-line XML comment syntax when possible
#   -> contradicts roslynator_doc_comment_summary_style = multi_line and RCS1253
dotnet_diagnostic.MA0177.severity = none

# MA0192: Use HasFlag instead of bitwise checks
#   -> contradicts roslynator_enum_has_flag_style = operator and RCS1096
dotnet_diagnostic.MA0192.severity = none

